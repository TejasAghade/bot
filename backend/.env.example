DATA_DIR=data
URLS_FILE=data/urls.txt
VECTORSTORE_DIR=vectorstore
COLLECTION_NAME=docs

CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=4
MAX_CONTEXT_DOCS=3
MAX_CONTEXT_CHARS=3500
MIN_RELEVANCE=0.55
FAST_PATH_MIN_RELEVANCE=0.60
FAST_PATH_MIN_OVERLAP=0.20
FAST_PATH_MAX_DOCS=2
MAX_ANSWER_SENTENCES=6
ANSWER_CACHE_SIZE=128

OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
LLM_NUM_PREDICT=192
OLLAMA_KEEP_ALIVE=30m
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_KEEP_ALIVE=1800
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_WIKI=
AZURE_DEVOPS_WIKI_PATH=/
AZURE_DEVOPS_API_VERSION=7.1

# SharePoint (Microsoft Graph, app-only). When all three creds are set, ingestion
# also pulls every supported file from every SharePoint site/folder the app can read.
# The app registration needs Sites.Read.All / Files.Read.All (Application) with
# admin consent.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
# Optional: limit to one site (Graph site id or "host:/sites/Name"). Blank = all sites.
SHAREPOINT_SITE=
# Optional: comma-separated folder names/paths to restrict ingestion. Blank = all folders.
SHAREPOINT_FOLDERS=

# Comma-separated list, e.g. http://localhost:3000,http://localhost:5173
CORS_ORIGINS=*
